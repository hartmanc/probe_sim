# per-circuit compare folders: imagery ignored, the markdown records (survey, findings, manifest, READMEs) tracked
tools/track/compare/sonoma/**
!tools/track/compare/sonoma/**/
!tools/track/compare/sonoma/**/*.md
!tools/track/compare/sonoma/edges_r14b/index.html
!tools/track/compare/sonoma/edges_r14b/intro.html
!tools/track/compare/sonoma/edges_r14b/extra.html
!tools/track/compare/sonoma/owner_edges_r14b/*.json
!tools/track/compare/sonoma/owner_edges_r14b/docs/*.json
tools/track/compare/buttonwillow/**
!tools/track/compare/buttonwillow/**/
!tools/track/compare/buttonwillow/**/*.md
!tools/track/compare/buttonwillow/edges_r9/index.html
!tools/track/compare/buttonwillow/edges_r10/index.html
# eye-level inventory (21 Oct 2026): the rows, sources and inventory.json are tracked for every circuit; the video
# frames and the compare sheets (reference imagery) never are
!tools/track/compare/*/inventory.json
!tools/track/compare/*/inventory/*.jsonl
!tools/track/compare/*/inventory/source.json
tools/track/compare/*/inventory/frames
tools/track/compare/*/compare_sheets
