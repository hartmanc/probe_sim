# tools/track: scripts, configs and markdown records are tracked; downloads, captures, frames, outputs and previews
# are not (no trailing slash: in a worktree these may be symlinks to the main checkout's data, which a "dir/" rule
# does not match)
tools/track/cache
tools/track/out
tools/track/previews
tools/track/compare/satellite
tools/track/compare/satellite_clean
tools/track/compare/satellite_sheets
